{
  "name": "ticketing-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Microservices ticketing system monorepo",
  "workspaces": [
    "auth",
    "client",
    "common",
    "email-service",
    "expiration",
    "orders",
    "payments",
    "tickets"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci --concurrency=1",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "pnpm build:common",
    "build:common": "pnpm --filter @ethtickets/common build",
    "watch:common": "pnpm --filter @ethtickets/common build --watch",
    "skaffold:dev": "pnpm build:common && skaffold dev",
    "local:up": "docker-compose -f docker-compose.local.yml up -d",
    "local:down": "docker-compose -f docker-compose.local.yml down",
    "local:logs": "docker-compose -f docker-compose.local.yml logs -f",
    "mocks:up": "docker-compose -f docker-compose.contracts.yml up -d",
    "mocks:down": "docker-compose -f docker-compose.contracts.yml down",
    "mocks:logs": "docker-compose -f docker-compose.contracts.yml logs -f"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.9.0"
}
